{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Language Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["language_id", "name", "identity_status", "source_ids", "record_status"],
  "properties": {
    "language_id": {"type": "string", "pattern": "^lng-[a-z0-9-]+$"},
    "name": {"type": "string", "minLength": 1},
    "autonyms": {"type": "array", "items": {"type": "string"}},
    "identity_status": {"enum": ["community_designation", "scholarly_designation", "catalogue_label", "provisional", "disputed", "undecided"]},
    "external_identifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scheme", "value", "status", "source_ids"],
        "properties": {
          "scheme": {"enum": ["ISO-639-3", "BCP-47", "Glottolog", "Wikidata", "other"]},
          "value": {"type": "string", "minLength": 1},
          "status": {"enum": ["verified", "provisional", "disputed", "rejected"]},
          "source_ids": {"type": "array", "items": {"type": "string", "pattern": "^src-[a-z0-9-]+$"}},
          "checked_date": {"type": ["string", "null"], "format": "date"},
          "notes": {"type": "string"}
        }
      }
    },
    "source_ids": {"type": "array", "items": {"type": "string", "pattern": "^src-[a-z0-9-]+$"}},
    "record_status": {"enum": ["draft", "proposed", "accepted", "deprecated", "retracted"]},
    "notes": {"type": "string"}
  }
}
