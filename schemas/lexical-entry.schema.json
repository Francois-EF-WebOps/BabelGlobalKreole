{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lexical Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entry_id",
    "concept_id",
    "language_id",
    "form",
    "definition",
    "evidence_status",
    "rights_status",
    "record_status",
    "ai_use",
    "source_ids",
    "source_locations"
  ],
  "properties": {
    "entry_id": {
      "type": "string",
      "pattern": "^lex-[a-z0-9-]+$"
    },
    "concept_id": {
      "type": "string",
      "pattern": "^con-[a-z0-9-]+$"
    },
    "language_id": {
      "type": "string",
      "pattern": "^lng-[a-z0-9-]+$"
    },
    "variety_id": {
      "type": "string",
      "pattern": "^var-[a-z0-9-]+$"
    },
    "form": {
      "type": "string",
      "minLength": 1
    },
    "pronunciation": {
      "type": "string"
    },
    "pronunciation_system": {
      "type": "string"
    },
    "part_of_speech": {
      "type": "string"
    },
    "definition": {
      "type": "string",
      "minLength": 1
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "register": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^src-[a-z0-9-]+$"
      }
    },
    "evidence_status": {
      "enum": [
        "attested",
        "scholarly_analysis",
        "comparative_observation",
        "proposed_convergence",
        "creative_coinage",
        "application_canon",
        "disputed",
        "undecided",
        "retracted"
      ]
    },
    "rights_status": {
      "enum": [
        "verified-permitted",
        "restricted",
        "unknown",
        "not-applicable",
        "permission-pending"
      ]
    },
    "record_status": {
      "enum": [
        "draft",
        "proposed",
        "accepted",
        "deprecated",
        "retracted"
      ]
    },
    "confidence_rationale": {
      "type": "string"
    },
    "decision_ref": {
      "type": "string"
    },
    "ai_use": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retrieval": {
          "enum": [
            "allowed",
            "denied",
            "permission-required",
            "unknown"
          ]
        },
        "redistribution": {
          "enum": [
            "allowed",
            "denied",
            "permission-required",
            "unknown"
          ]
        },
        "training": {
          "enum": [
            "allowed",
            "denied",
            "permission-required",
            "unknown"
          ]
        },
        "speech_generation": {
          "enum": [
            "allowed",
            "denied",
            "permission-required",
            "unknown"
          ]
        },
        "synthetic_data": {
          "enum": [
            "allowed",
            "denied",
            "permission-required",
            "unknown"
          ]
        },
        "community_consent_status": {
          "enum": [
            "not-applicable",
            "obtained",
            "declined",
            "required",
            "withheld",
            "unknown"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "retrieval",
        "redistribution",
        "training",
        "speech_generation",
        "synthetic_data",
        "community_consent_status"
      ]
    },
    "source_locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "location"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^src-[a-z0-9-]+$"
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "quote_or_locator": {
            "type": "string"
          }
        }
      }
    }
  },
  "$id": "https://raw.githubusercontent.com/Francois-EF-WebOps/BabelGlobalKreole/main/schemas/lexical-entry.schema.json",
  "schema_version": "1.2.0"
}
