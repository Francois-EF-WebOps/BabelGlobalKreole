{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Francois-EF-WebOps/BabelGlobalKreole/main/schemas/grammar-rule.schema.json",
  "schema_version": "1.1.0",
  "title": "Grammar Rule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_id",
    "language_id",
    "label",
    "statement",
    "evidence_status",
    "record_status",
    "source_ids",
    "source_locations"
  ],
  "properties": {
    "rule_id": {
      "type": "string",
      "pattern": "^grm-[a-z0-9-]+$"
    },
    "language_id": {
      "type": "string",
      "pattern": "^lng-[a-z0-9-]+$"
    },
    "variety_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^var-[a-z0-9-]+$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "counterexamples": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^src-[a-z0-9-]+$"
      }
    },
    "source_locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "location"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^src-[a-z0-9-]+$"
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "quote_or_locator": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "evidence_status": {
      "enum": [
        "attested",
        "scholarly_analysis",
        "comparative_observation",
        "proposed_convergence",
        "creative_coinage",
        "application_canon",
        "disputed",
        "undecided",
        "retracted"
      ]
    },
    "rights_status": {
      "enum": [
        "verified-permitted",
        "restricted",
        "unknown",
        "not-applicable",
        "permission-pending"
      ]
    },
    "record_status": {
      "enum": [
        "draft",
        "proposed",
        "accepted",
        "deprecated",
        "retracted"
      ]
    },
    "decision_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
