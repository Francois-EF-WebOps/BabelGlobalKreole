{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Grammar Rule",
  "type":"object",
  "additionalProperties":false,
  "required":["rule_id","language_id","label","statement","evidence_status","record_status"],
  "properties":{
    "rule_id":{"type":"string","pattern":"^grm-[a-z0-9-]+$"},
    "language_id":{"type":"string"},
    "variety_id":{"type":["string","null"]},
    "label":{"type":"string"},
    "statement":{"type":"string"},
    "examples":{"type":"array","items":{"type":"object"}},
    "counterexamples":{"type":"array","items":{"type":"string"}},
    "scope":{"type":"string"},
    "source_ids":{"type":"array","items":{"type":"string"}},
    "evidence_status":{"enum":["attested","scholarly_analysis","comparative_observation","proposed_convergence","creative_coinage","application_canon","disputed","undecided","retracted"]},
    "rights_status":{"enum":["verified-permitted","restricted","unknown","not-applicable","permission-pending"]},
    "record_status":{"enum":["draft","proposed","accepted","deprecated","retracted"]},
    "decision_ref":{"type":["string","null"]}
  }
}
